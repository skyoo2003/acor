# IDE
/.vscode/
/.idea/
/.serena/
/.sisyphus/
/.claude/

# Build
/bin/
/dist/
/bin/*.exe
/bin/*.exe~
/bin/*.dll
/bin/*.so
/bin/*.dylib

# Test
*.test
*.prof
/coverage.out
/coverage.html
cov*.out
coverage*.out
/tmp/

# Dependencies
/vendor/
/src/

# Environment
# NOTE: !.env.example must appear after .env.* to override it
.env
.env.*
!.env.example

# OS
.DS_Store
Thumbs.db

# Project
/.vagrant/
/.worktrees/
/docs/superpowers/
/docs/plans/
/docs/specs/

# doccheck temp build dirs (usually auto-cleaned)
/.doccheck/
/server/.doccheck/

# Hugo build output. CI builds the site in its own runner, so these only ever
# appear when someone runs `hugo` locally to preview a docs change — and 33
# generated pages are one `git add -A` from being committed.
/docs/public/
/docs/.hugo_build.lock

# licensesnap scratch file. `make license-check` removes it on failure, but a
# Ctrl-C during the three cross-GOOS `go list` calls leaves it behind, and an
# untracked half-written NOTICE is one `git add -A` from being committed.
/NOTICE.tmp
